# ---- Required: fill these in ----
# Public hostname the site is served on (Caddy gets a TLS certificate for it)
DOMAIN=at.example.org
# Email for Let's Encrypt expiry notices
ACME_EMAIL=you@example.org
# Generate both with: make init   (or: openssl rand -base64 48)
SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me
POSTGRES_PASSWORD=change-me
# From https://developers.eveonline.com : create an application with
# callback URL https://$DOMAIN/auth/callback and scope publicData
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# CCP asks that ESI clients identify themselves with a contact address
ESI_CONTACT_EMAIL=you@example.org
TEAM_NAME=My AT Team

# ---- Optional ----
# rclone remote for nightly pg_dump copies, e.g. b2:attool-backups (leave empty to keep backups local only)
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30
# ESI compatibility date the backend was written against; bump deliberately after re-testing
ESI_COMPAT_DATE=2026-08-01
# Image tag to run; pin to a release tag to hold a version
ATTOOL_VERSION=latest
# SDE loader: files land in the `instance` volume; the scheduler checks CCP daily
#INSTANCE_DIR=/app/instance
#SDE_AUTO_DOWNLOAD=true
#SDE_STALE_DAYS=45
#SDE_INCLUDED_FILES=categories,groups,metaGroups,factions,races,types,marketGroups,typeBonus,typeDogma,dogmaAttributes,dogmaEffects
#SDE_TYPE_CATEGORIES=6,7,8,18,20,22,32
DJANGO_LOG_LEVEL=INFO
